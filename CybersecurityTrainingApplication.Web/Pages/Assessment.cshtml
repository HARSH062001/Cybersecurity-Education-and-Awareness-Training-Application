@page
@model CybersecurityTrainingApplication.Web.Pages.AssessmentModel
@{ ViewData["Title"] = "Assessment"; }
<a class="back-link" asp-page="/Modules">← Back to modules</a><div class="page-heading"><span class="eyebrow">Module 1 · Question Bank @Model.Bank</span><h1>Cybersecurity Fundamentals assessment</h1><p>Answer the question below. Your answers will be saved by the connected backend.</p></div>
<div class="assessment-layout"><div class="question-panel"><div class="question-progress">Question @Model.QuestionNumber of @Model.TotalQuestions</div><h2>@Model.Question</h2>@foreach(var option in Model.Options){<label class="answer-option"><input type="radio" name="answer" value="@option.Code" /> <span><b>@option.Code</b> @option.Text</span></label>}<div class="d-flex justify-content-between mt-4"><button class="btn btn-outline-secondary" disabled>Previous</button><a class="btn btn-primary" asp-page="/Results" asp-route-bank="@Model.Bank">Submit assessment</a></div></div><aside class="assessment-side"><h3>Assessment guide</h3><p>Take your time and select the answer that best matches the safe workplace response.</p><hr/><p><b>Bank:</b> @Model.Bank</p><p><b>Questions:</b> 10</p><p><b>Attempts:</b> Recorded by the application</p></aside></div>
