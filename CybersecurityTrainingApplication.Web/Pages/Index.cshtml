@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center mb-5">
    <h1 class="display-4">Cybersecurity Education and Awareness Training</h1>
    <p class="lead">Employee learning prototype</p>
</div>

@if (Model.Module is not null)
{
    <section class="mb-4">
        <h2>@Model.Module.Title</h2>
        <p>@Model.Module.Purpose</p>
        <p>@Model.Module.Content</p>
    </section>
    <h3>Assessment banks</h3>
    <div class="row">
        @foreach (var bank in Model.Module.QuestionBanks)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h4 class="card-title">@bank.Title</h4>
                        <p class="card-text">Assessment bank for repeated-attempt support.</p>
                        <a class="btn btn-primary" href="#">Start assessment</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
