<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4000720e-f1e4-43e1-8776-6738cb14d92e</UserSecretsId>
  </PropertyGroup>

  <!-- Identity handles accounts; EF Core will store application data in SQLite. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\module-content.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Data\assessment-preview.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Refresh the learning content from the team's Word documents before building. -->
  <PropertyGroup>
    <ModulePython Condition="'$(ModulePython)' == '' and '$(OS)' == 'Windows_NT'">python</ModulePython>
    <ModulePython Condition="'$(ModulePython)' == ''">python3</ModulePython>
  </PropertyGroup>
  <Target Name="SyncModuleContent" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true' and '$(SkipModuleSync)' != 'true'">
    <Exec Command="&quot;$(ModulePython)&quot; &quot;$(MSBuildProjectDirectory)/../Tools/SyncModulesFromWord.py&quot;" />
  </Target>

</Project>
