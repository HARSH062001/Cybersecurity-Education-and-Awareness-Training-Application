@page
@model CybersecurityTrainingWeb.Pages.ModuleModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Title)
        ? "Learning Module"
        : Model.Title;
}

<a class="back-link" asp-page="/Modules">
    <span aria-hidden="true">←</span>
    <span>Back to modules</span>
</a>

<header class="learning-header">
    <div class="learning-header__inner">
        <div class="learning-header__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="32" height="32" fill="none"
                 stroke="currentColor" stroke-width="1.8">
                <path d="M12 3 4.5 6v5.2c0 4.7 3.1 8.5 7.5 9.8 4.4-1.3 7.5-5.1 7.5-9.8V6L12 3Z" />
                <path d="m8.8 12.1 2.1 2.1 4.5-4.7" />
            </svg>
        </div>

        <div>
            <p class="eyebrow">Module @Model.ModuleId · Employee learning</p>
            <h1>@Model.Title</h1>
            <p class="lead">@Model.Purpose</p>

            <div class="module-meta">
                <span>@Model.LearningSections.Count learning sections</span>
                <span>Workplace-focused content</span>
            </div>
        </div>
    </div>
</header>

@* The section keys connect completion controls to saved progress. *@
<div class="learning-workspace" data-module-learning="@Model.ModuleId">
    <aside class="learning-sidebar" aria-label="Module progress and navigation">
        <div class="learning-sidebar__progress">
            <div class="progress-ring" data-progress-ring>
                <strong data-progress-percent>0%</strong>
            </div>

            <div>
                <strong data-progress-count>
                    0 of @Model.LearningSections.Count sections
                </strong>
                <p>Your progress is saved on this device.</p>
            </div>
        </div>

        <nav class="learning-section-list" aria-label="Module sections">
            @for (var index = 0; index < Model.LearningSections.Count; index++)
            {
                var learningSection = Model.LearningSections[index];

                <a class="learning-section-link"
                   href="#section-@(learningSection.Key)"
                   data-section-link="@(learningSection.Key)">
                    <span class="learning-section-link__number">@(index + 1)</span>
                    <span>@learningSection.Title</span>
                </a>
            }
        </nav>

        <div class="learning-help">
            <strong>How completion works</strong>
            <p>Review a section, then use its completion control. Your progress updates as you go.</p>
        </div>
    </aside>

    <div class="learning-sections">
        @if (Model.LearningSections.Count == 0)
        {
            <section class="learning-card">
                <div class="learning-card__body">
                    <h2>Module content is not available</h2>
                    <p>Check that this module has content in the module data file.</p>
                </div>
            </section>
        }
        else
        {
            @for (var index = 0; index < Model.LearningSections.Count; index++)
            {
                var learningSection = Model.LearningSections[index];

                <section class="learning-card"
                         id="section-@(learningSection.Key)"
                         data-progress-section="@(learningSection.Key)">
                    <header class="learning-card__heading">
                        <p class="eyebrow">
                            Section @(index + 1) of @Model.LearningSections.Count
                        </p>
                        <h2>@learningSection.Title</h2>
                        <p>@learningSection.Summary</p>
                        <span class="status-badge" data-section-status>Not completed</span>
                    </header>

                    <div class="learning-card__body">
                        @foreach (var block in learningSection.Blocks)
                        {
                            if (string.Equals(block.Kind, "heading", StringComparison.OrdinalIgnoreCase))
                            {
                                <h3>@block.Text</h3>
                            }
                            else if (string.Equals(block.Kind, "bullet", StringComparison.OrdinalIgnoreCase))
                            {
                                <p class="learning-bullet">
                                    <span aria-hidden="true">•</span> @block.Text
                                </p>
                            }
                            else if (string.Equals(block.Kind, "table", StringComparison.OrdinalIgnoreCase)
                                     && block.Rows.Count > 0)
                            {
                                var headerCells = block.Rows[0];
                                var isChecklist = headerCells.Count > 1
                                    && string.Equals(headerCells[0].Trim(), "Check",
                                        StringComparison.OrdinalIgnoreCase)
                                    && headerCells[^1].Trim().StartsWith("Complete",
                                        StringComparison.OrdinalIgnoreCase);

                                if (isChecklist)
                                {
                                    @* Imported checklist symbols are text; section progress uses the control below. *@
                                    <div class="learning-review-list">
                                        <h3>Review checklist</h3>
                                        <ul>
                                            @foreach (var row in block.Rows.Skip(1))
                                            {
                                                if (row.Count > 0 && !string.IsNullOrWhiteSpace(row[0]))
                                                {
                                                    <li>@row[0]</li>
                                                }
                                            }
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <tbody>
                                                @for (var rowIndex = 0; rowIndex < block.Rows.Count; rowIndex++)
                                                {
                                                    <tr>
                                                        @foreach (var cell in block.Rows[rowIndex])
                                                        {
                                                            if (rowIndex == 0)
                                                            {
                                                                <th scope="col">@cell</th>
                                                            }
                                                            else
                                                            {
                                                                <td>@cell</td>
                                                            }
                                                        }
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(block.Text))
                            {
                                <p>@block.Text</p>
                            }
                        }
                    </div>

                    <footer class="learning-card__footer">
                        <button class="section-complete-toggle"
                                type="button"
                                data-complete-section="@(learningSection.Key)"
                                aria-pressed="false">
                            <span class="section-complete-toggle__box" aria-hidden="true"></span>
                            <span data-button-label>Mark section complete</span>
                        </button>

                        <nav class="section-nav" aria-label="Move between sections">
                            @if (index > 0)
                            {
                                <a class="section-nav__link section-nav__link--previous"
                                   href="#section-@(Model.LearningSections[index - 1].Key)">
                                    <span aria-hidden="true">←</span>
                                    Previous section
                                </a>
                            }

                            @if (index < Model.LearningSections.Count - 1)
                            {
                                <a class="section-nav__link section-nav__link--next"
                                   href="#section-@(Model.LearningSections[index + 1].Key)">
                                    Next section
                                    <span aria-hidden="true">→</span>
                                </a>
                            }
                            else
                            {
                                <a class="section-nav__link section-nav__link--next"
                                   asp-page="/Assessment"
                                   asp-route-moduleId="@Model.ModuleId">
                                    Start assessment
                                    <span aria-hidden="true">→</span>
                                </a>
                            }
                        </nav>
                    </footer>
                </section>
            }
        }

        <section class="completion-note" data-completion-banner hidden>
            <h2>Module sections complete</h2>
            <p>You have confirmed every learning section. You can now try the knowledge assessment.</p>
            <a class="btn btn-primary"
               asp-page="/Assessment"
               asp-route-moduleId="@Model.ModuleId">
                Start knowledge assessment
            </a>
        </section>
    </div>
</div>

@section Scripts {
    @* Updates section completion and progress from this browser. *@
    <script src="~/js/module-progress.js" asp-append-version="true"></script>
}