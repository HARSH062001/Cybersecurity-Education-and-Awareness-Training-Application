@page
@model CybersecurityTrainingWeb.Pages.AssessmentModel
@{
    ViewData["Title"] = "Knowledge Assessment";
}

<a class="back-link" asp-page="/Module" asp-route-id="@Model.ModuleId">
    ← Back to Module @Model.ModuleId
</a>

@* The script uses these values to keep this practice attempt together. *@
<div class="assessment-workspace"
     data-assessment
     data-module-id="@Model.ModuleId"
     data-bank="@Model.Bank"
     data-total-questions="@Model.Questions.Count">

    <header class="assessment-hero">
        <div>
            <p class="eyebrow">Module @Model.ModuleId · Assigned assessment</p>
            <h1>@Model.ModuleTitle</h1>
            <p>
                Read each question carefully and choose the safest workplace response.
                A question bank is assigned automatically for this attempt.
            </p>
        </div>

        <div class="assessment-hero__meta">
            <strong>@Model.Questions.Count questions</strong>
            <span>Bank assigned automatically</span>
        </div>
    </header>

    <section class="assessment-progress" aria-label="Assessment progress">
        <div>
            <strong data-assessment-count>Question 1 of @Model.Questions.Count</strong>
            <span data-assessment-answered>0 answered</span>
        </div>

        <div class="progress-track" role="progressbar"
             aria-label="Question progress"
             aria-valuemin="0"
             aria-valuemax="@Model.Questions.Count"
             aria-valuenow="1">
            <div class="progress-track__fill"
                 data-assessment-bar
                 style="width: 0%"></div>
        </div>
    </section>

    <div class="assessment-layout">
        <aside class="question-nav" aria-label="Assessment question navigation">
            <p class="eyebrow">Questions</p>

            <div class="question-nav__grid">
                @for (var index = 0; index < Model.Questions.Count; index++)
                {
                    <button class="question-nav__button"
                            type="button"
                            data-question-nav="@index"
                            aria-label="Go to question @(index + 1)">
                        @(index + 1)
                    </button>
                }
            </div>

            <div class="learning-help">
                <strong>Your responses</strong>
                <p>Your answers are kept in this browser while you work.</p>
                <p>Final marking and saved assessment records require the backend connection.</p>
            </div>
        </aside>

        <div class="assessment-questions">
            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];

                <section class="question-card"
                         data-question-panel="@index"
                         hidden="@(index != 0 ? "hidden" : null)">
                    <p class="eyebrow">Question @(index + 1)</p>
                    <h2 class="question-card__title">@question.Text</h2>

                    @if (question.Type == "multipleChoice")
                    {
                        <fieldset>
                            <legend>Select one answer</legend>

                            @foreach (var option in question.Options)
                            {
                                <label class="answer-option">
                                    <input type="radio"
                                           name="@question.Id"
                                           value="@option.Code"
                                           data-answer-input="@question.Id" />
                                    <span class="answer-option__code">@option.Code</span>
                                    <span>@option.Text</span>
                                </label>
                            }
                        </fieldset>
                    }
                    else
                    {
                        <div class="scenario-response">
                            <p class="eyebrow">Workplace scenario</p>
                            <p>Describe the safest action you would take.</p>

                            <label for="@question.Id">Your response</label>
                            <textarea id="@question.Id"
                                      rows="5"
                                      data-answer-input="@question.Id"
                                      placeholder="Describe the safe action you would take..."></textarea>
                        </div>
                    }

                    <footer class="question-card__actions">
                        <button class="btn btn-outline-primary"
                                type="button"
                                data-previous-question>
                            Previous
                        </button>

                        <span data-question-feedback aria-live="polite"></span>

                        <button class="btn btn-primary"
                                type="button"
                                data-next-question>
                            Next question
                        </button>

                        <button class="btn btn-primary"
                                type="button"
                                data-submit-assessment
                                hidden>
                            Submit assessment
                        </button>
                    </footer>
                </section>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/assessment.js" asp-append-version="true"></script>
}