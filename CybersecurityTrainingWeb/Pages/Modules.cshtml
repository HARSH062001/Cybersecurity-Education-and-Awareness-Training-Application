@* Renders the module catalogue and enrolment controls. *@
@page
@model ModulesModel

@{
    ViewData["Title"] = "Training Modules";
    var firstModule = Model.Modules.FirstOrDefault();
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

<section class="catalogue-hero">
    <div>
        <p class="eyebrow">Learning catalogue</p>
        <h1>Build safer workplace habits</h1>
        <p class="lead">
            Explore the cybersecurity modules. Sign in to enrol and save your learning progress.
        </p>
    </div>
</section>

@if (TempData["EnrollmentMessage"] is string enrollmentMessage)
{
    @* Confirm the result of the learner's enrolment action accessibly. *@
    <div class="alert alert-success" role="status">
        @enrollmentMessage
    </div>
}

@if (firstModule is not null)
{
    @* The first module is featured as a recommended starting point. *@
    <section class="featured-module"
             data-module-progress="@firstModule.Number">
        <div class="featured-module__content">
            <p class="eyebrow">Recommended first · Module @firstModule.Number</p>
            <h2>@firstModule.Title</h2>
            <p class="lead">@firstModule.Summary</p>

            <div class="module-meta">
                <span>7 guided sections</span>
                <span>About 25 minutes</span>
                <span>No prior knowledge needed</span>
            </div>

            @if (Model.EnrolledModuleIds.Contains(firstModule.Number))
            {
                <a class="btn btn-primary"
                   asp-page="/Module"
                   asp-route-id="@firstModule.Number"
                   data-progress-action>
                    Continue Module @firstModule.Number
                </a>
                <p class="mt-2"><strong>You are enrolled in this module.</strong></p>
            }
            else if (isSignedIn)
            {
                @* The POST handler records this learner's enrolment in the database. *@
                <form method="post"
                      asp-page-handler="Enroll"
                      class="d-inline">
                    <input type="hidden"
                           name="moduleId"
                           value="@firstModule.Number" />
                    <button class="btn btn-primary" type="submit">
                        Enrol in Module @firstModule.Number
                    </button>
                </form>
            }
            else
            {
                <a class="btn btn-primary"
                   asp-area="Identity"
                   asp-page="/Account/Login"
                   asp-route-ReturnUrl="/Modules">
                    Sign in to enrol
                </a>
            }
        </div>

        <div class="featured-module__progress"
             aria-label="Module @firstModule.Number progress">
            <div class="progress-ring">
                <strong data-progress-value>0%</strong>
            </div>
            <p data-progress-sections>0 of 7 sections complete</p>
            <small>Progress updates when you confirm a section.</small>
        </div>
    </section>
}

<section class="pathway-section">
    <div class="home-section__intro">
        <p class="eyebrow">Available modules</p>
        <h2>Explore the learning pathway</h2>
        <p class="lead">
            Choose a module and enrol to associate your learning activity with your account.
        </p>
    </div>

    @if (Model.Modules.Count == 0)
    {
        <p class="alert alert-info" role="status">
            No modules are currently available.
        </p>
    }
    else
    {
        <div class="module-grid">
            @foreach (var module in Model.Modules.Where(
                item => firstModule is null || item.Number != firstModule.Number))
            {
                <article class="module-card"
                         data-module-progress="@module.Number">
                    <div class="module-card__top">
                        <span class="eyebrow">Module @module.Number</span>
                        <span class="module-status" data-module-status>
                            Not started
                        </span>
                    </div>

                    <h3>@module.Title</h3>
                    <p>@module.Summary</p>

                    <div class="module-card__meta">
                        <strong data-progress-value>0%</strong>
                        <span data-progress-sections>0 of 7 sections complete</span>
                    </div>

                    @if (Model.EnrolledModuleIds.Contains(module.Number))
                    {
                        <a class="btn btn-primary"
                           asp-page="/Module"
                           asp-route-id="@module.Number"
                           data-progress-action>
                            Continue Module @module.Number
                        </a>
                        <p class="mt-2"><strong>You are enrolled.</strong></p>
                    }
                    else if (isSignedIn)
                    {
                        @* The enrolment handler checks the module and prevents duplicate records. *@
                        <form method="post"
                              asp-page-handler="Enroll"
                              class="d-inline">
                            <input type="hidden"
                                   name="moduleId"
                                   value="@module.Number" />
                            <button class="btn btn-primary" type="submit">
                                Enrol in Module @module.Number
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary"
                           asp-area="Identity"
                           asp-page="/Account/Login"
                           asp-route-ReturnUrl="/Modules">
                            Sign in to enrol
                        </a>
                    }
                </article>
            }
        </div>
    }
</section>

@section Scripts {
    @* Loads each learner's saved section progress into the catalogue cards. *@
    <script src="~/js/module-progress.js" asp-append-version="true"></script>
}