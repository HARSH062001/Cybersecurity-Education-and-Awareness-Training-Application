@page
@using CybersecurityTrainingWeb.Data
@model CybersecurityTrainingWeb.Pages.AssessmentHistoryModel
@{
    ViewData["Title"] = "Assessment history";
}

<section class="privacy-hero">
    <p class="eyebrow">Your account</p>
    <h1>Assessment history</h1>
    <p class="lead">
        Continue an unfinished assessment or review a completed result.
    </p>
</section>

@if (Model.Attempts.Count == 0)
{
    <section class="panel p-4">
        <h2>No assessments yet</h2>
        <p>Choose a module to start your first assessment.</p>
        <a class="btn btn-primary" asp-page="/Modules">
            Browse modules
        </a>
    </section>
}
else
{
    <div class="row g-3">
        @foreach (var attempt in Model.Attempts)
        {
            <div class="col-12 col-lg-6">
                <article class="panel p-4 h-100">
                    <p class="eyebrow">Module @attempt.ModuleId</p>
                    <h2 class="h4">@attempt.ModuleTitle</h2>

                    <p>
                        Started:
                        <time datetime="@attempt.StartedAtUtc.ToString("O")">
                            @attempt.StartedAtUtc.ToString("dd MMM yyyy, HH:mm") UTC
                        </time>
                    </p>

                    @if (attempt.Status == AssessmentAttemptStatus.Completed)
                    {
                        <p>
                            <strong>Score:</strong>
                            @attempt.Score of @attempt.TotalQuestions
                        </p>
                        <a class="btn btn-primary"
                           asp-page="/Results"
                           asp-route-attemptId="@attempt.Id">
                            Review answers
                        </a>
                    }
                    else if (attempt.Status == AssessmentAttemptStatus.InProgress)
                    {
                        <p><strong>Status:</strong> In progress</p>
                        <a class="btn btn-primary"
                           asp-page="/Assessment"
                           asp-route-attemptId="@attempt.Id">
                            Continue assessment
                        </a>
                    }
                    else
                    {
                        <p><strong>Status:</strong> Awaiting review</p>
                    }
                </article>
            </div>
        }
    </div>
}