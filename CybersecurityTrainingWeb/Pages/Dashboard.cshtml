@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
    var firstModuleTitle = Model.Modules.FirstOrDefault()?.Title
        ?? "Cybersecurity Fundamentals";
}

@* Module names come from the existing content file. The progress script will use them. *@
<div hidden aria-hidden="true" data-dashboard-modules>
    @foreach (var module in Model.Modules)
    {
        <span data-module-id="@module.Id" data-module-title="@module.Title"></span>
    }
</div>

<section class="dashboard-hero">
    <div class="dashboard-hero__copy">
        <p class="eyebrow">Learner dashboard</p>
        <h1>Your learning overview</h1>
        <p class="lead">Track your module progress and continue learning at your own pace.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Modules">Browse all modules</a>
</section>

<section class="stats-grid" aria-label="Learning summary">
    <article class="stat-card" data-overall-progress>
        <p>Overall learning</p>
        <strong class="stat-card__value" data-overall-percent>0%</strong>
        <small data-overall-detail>0 of 8 modules completed</small>

        <div class="progress-track" role="progressbar"
             aria-label="Overall learning progress"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="progress-track__fill" data-overall-bar style="width: 0%"></div>
        </div>
    </article>

    <article class="stat-card" data-module-progress="1" data-dashboard-focus>
        <p data-current-module-label>Module 1 progress</p>
        <strong class="stat-card__value" data-progress-value>0%</strong>
        <small data-progress-sections>0 of 7 sections complete</small>

        <div class="progress-track" role="progressbar"
             aria-label="Module 1 progress"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="progress-track__fill" data-module-bar style="width: 0%"></div>
        </div>
    </article>

    <article class="stat-card stat-card--soft">
        <p>Knowledge assessments</p>
        <strong class="stat-card__value">24 question banks</strong>
        <small>Three practice banks are available for each of the eight modules.</small>
    </article>
</section>

<section class="continue-card" data-module-progress="1" data-dashboard-focus>
    <div class="continue-card__content">
        <div class="continue-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="30" height="30" fill="none"
                 stroke="currentColor" stroke-width="1.8">
                <path d="M12 3 4.5 6v5.2c0 4.7 3.1 8.5 7.5 9.8 4.4-1.3 7.5-5.1 7.5-9.8V6L12 3Z" />
                <path d="m8.8 12.1 2.1 2.1 4.5-4.7" />
            </svg>
        </div>

        <div>
            <p class="eyebrow">Continue learning</p>
            <h2 data-current-module-title>@firstModuleTitle</h2>
            <p>
               You can try a practice assessment; scores and saved attempts are not available yet.
            </p>
        </div>
    </div>

    <a class="btn btn-primary" asp-page="/Module" asp-route-id="1" data-progress-action>
        Start Module 1
    </a>
</section>

<section class="pathway-section">
    <div class="home-section__intro">
        <p class="eyebrow">Learning pathway</p>
        <h2>What comes next</h2>
    </div>

    <div class="pathway-grid">
        <article class="pathway-card">
            <span class="pathway-card__number">1</span>
            <h3>Complete learning sections</h3>
            <p>Work through each module at your own pace.</p>
        </article>

        <article class="pathway-card">
            <span class="pathway-card__number">2</span>
            <h3>Take a knowledge assessment</h3>
            <p>An available question bank is assigned for your attempt.</p>
        </article>

        <article class="pathway-card">
            <span class="pathway-card__number">3</span>
            <h3>Review practice responses</h3>
            <p>
                Completed learning sections are saved to your account.
                Assessment scores and attempt history are not available yet.
            </p>
        </article>
    </div>
</section>

@section Scripts {
    <script src="~/js/module-progress.js" asp-append-version="true"></script>
}