@* Renders the signed-in learner’s enrolments and assessment reminders. *@
@page
@model CybersecurityTrainingWeb.Pages.NotificationsModel
@{ ViewData["Title"] = "Training notifications"; }
<h1>Training notifications</h1>
<p>Your module assignments and current assessment reminders. Dates are shown in UTC.</p>
@if (Model.Notices.Count == 0) { <p>No training assignments yet. Visit the learning route to enrol.</p> }
@foreach(var notice in Model.Notices) {
<section class="panel p-4 mb-3"><h2 class="h4">Module @notice.ModuleId</h2><p>@notice.Message</p>
@if (notice.DueAtUtc is DateTime due) { <p>Due: @due.ToString("dd MMM yyyy HH:mm") UTC</p> }
<a asp-page="/Module" asp-route-id="@notice.ModuleId">Study module</a>
@if (!notice.IsPassed) { <a asp-page="/Assessment" asp-route-moduleId="@notice.ModuleId">Open assessment</a> }
else { <span class="status-badge">Passed</span> }</section>
}
