@* Renders the score and question feedback for a completed attempt. *@
@page
@model CybersecurityTrainingWeb.Pages.ResultsModel
@{
    ViewData["Title"] = "Assessment result";
    var percentage = Model.TotalQuestions > 0
        ? (int)Math.Round(100.0 * Model.Score / Model.TotalQuestions)
        : 0;
}

<section class="results-hero">
    <p class="eyebrow">Assessment result</p>
    <h1>@(Model.IsPassed ? "Assessment passed" : Model.ModulePassed ? "Module passed" : "Keep learning and try again")</h1>
    <p>Module @Model.ModuleId · @Model.ModuleTitle</p>
    <div class="results-hero__stat">
        <strong>@Model.Score / @Model.TotalQuestions</strong>
        <span>correct answers · @percentage%</span>
    </div>
    <p class="mt-3">
        Passing mark: @Model.PassingPercentage%.
        @if (Model.IsPassed)
        {
            <span>You have passed this module. Further attempts are locked.</span>
        }
        else if (Model.ModulePassed)
        {
            <span>This attempt did not pass, but your best result is @Model.BestScore of @Model.BestTotalQuestions (@Model.BestPercentage%). Further attempts are locked because you already passed.</span>
        }
        else
        {
            <span>Review the module, then try another assessment attempt.</span>
        }
    </p>
</section>

<div class="results-workspace">
    <section class="results-card">
        <p class="eyebrow">Question feedback</p>
        <h2>Learn from each answer</h2>
        <p>Your result and selected answers are saved to your account.</p>

        @foreach (var question in Model.Questions)
        {
            var status = question.IsCorrect
                ? "Correct"
                : question.SelectedOptionCode is null ? "Not answered" : "Incorrect";
            <article class="question-card results-question mb-3">
                <p class="eyebrow">Question @question.Number · @status</p>
                <h3 class="question-card__title">@question.QuestionText</h3>
                <div class="results-answer-list" aria-label="Answer choices">
                    @foreach (var option in question.Options)
                    {
                        // Show if user answered correctly, and show correct answer only if user passes
                        var optionClass = (option.IsCorrect && Model.IsPassed)
                            ? "results-answer results-answer--correct"
                            : option.IsSelected
                                ? (option.IsCorrect) 
                                    ? "results-answer results-answer--correct"
                                    : "results-answer results-answer--incorrect"
                                : "results-answer";
                        <div class="@optionClass">
                            <span class="results-answer__code">@option.Code</span>
                            <span class="results-answer__text">@option.Text</span>

                            <span class="results-answer__status">
                            @if (option.IsSelected && option.IsCorrect)
                            {
                                <strong>Your answer · Correct</strong>
                            }
                            else if (option.IsSelected)
                            {
                                <strong>Your answer · Incorrect</strong>
                            }
                            else if (option.IsCorrect && Model.IsPassed)
                            {
                                <strong>Correct answer</strong>
                            }
                        </span>
                    </div>
                    }
                    @if (question.SelectedOptionCode is null)
                    {
                        <p class="mt-2"><strong>Your answer:</strong> No answer submitted.</p>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(question.Explanation))
                {
                    <p class="results-explanation mb-0"><strong>Why:</strong> @question.Explanation</p>
                }
                else
                {
                    <p class="results-explanation mb-0"><strong>Why:</strong> Compare the selected response with the safe workplace action described in this module.</p>
                }
            </article>
        }
    </section>

    <aside class="results-card">
        <h2>Assessment summary</h2>
        <dl class="results-summary">
            <div class="results-summary__row">
                <dt>Module</dt>
                <dd>Module @Model.ModuleId</dd>
            </div>
            <div class="results-summary__row">
                <dt>Questions answered</dt>
                <dd>@Model.Answered of @Model.TotalQuestions</dd>
            </div>
            <div class="results-summary__row">
                <dt>Score</dt>
                <dd>@Model.Score of @Model.TotalQuestions (@percentage%)</dd>
            </div>
            <div class="results-summary__row">
                <dt>Best score</dt>
                <dd>@Model.BestScore of @Model.BestTotalQuestions (@Model.BestPercentage%)</dd>
            </div>
            <div class="results-summary__row">
                <dt>Result</dt>
                <dd>@(Model.IsPassed ? "Passed" : "Not passed")</dd>
            </div>
        </dl>
        <a class="btn btn-primary w-100" asp-page="/Module" asp-route-id="@Model.ModuleId">
            Return to module
        </a>
        @if (Model.BestAttemptId is not null && Model.BestAttemptId != Model.AttemptId)
        {
            <p class="mt-3 mb-0">
                <a asp-page="/Results" asp-route-attemptId="@Model.BestAttemptId">Review your best result</a>
            </p>
        }
        @if (!Model.ModulePassed)
        {
            <p class="mt-3">
                <a asp-page="/Assessment" asp-route-moduleId="@Model.ModuleId">Try another assessment</a>
            </p>
        }
    </aside>
</div>
