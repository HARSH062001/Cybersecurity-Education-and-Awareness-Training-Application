@page
@model CybersecurityTrainingWeb.Pages.ResultsModel
@{
    ViewData["Title"] = "Assessment result";
    var percentage = Model.TotalQuestions > 0
        ? (int)Math.Round(100.0 * Model.Score / Model.TotalQuestions)
        : 0;
}

<section class="results-hero">
    <p class="eyebrow">Assessment result</p>
    <h1>Review your answers</h1>
    <p>Module @Model.ModuleId · @Model.ModuleTitle</p>

    <div class="results-hero__stat">
        <strong>@Model.Score / @Model.TotalQuestions</strong>
        <span>correct answers · @percentage%</span>
    </div>
</section>

<div class="results-workspace">
    <section class="results-card">
        <p class="eyebrow">Question review</p>
        <h2>Learn from each answer</h2>
        <p>
            Your answers and result are saved to your account.
            Review every question below to see the correct response.
        </p>

        @foreach (var question in Model.Questions)
        {
            var status = question.IsCorrect
                ? "Correct"
                : question.SelectedOptionCode is null
                    ? "Not answered"
                    : "Incorrect";

            <article class="border rounded p-3 mb-3">
                <p class="eyebrow mb-2">Question @question.Number · @status</p>
                <h3 class="h5">@question.QuestionText</h3>

                <p class="mb-2">
                    <strong>Your answer:</strong>
                    @if (question.SelectedOptionCode is null)
                    {
                        <span>No answer submitted</span>
                    }
                    else
                    {
                        <span>
                            @question.SelectedOptionCode.
                            @question.SelectedOptionText
                        </span>
                    }
                </p>

                <p class="mb-2">
                    <strong>Correct answer:</strong>
                    @if (question.CorrectOptionCode is null)
                    {
                        <span>Answer unavailable</span>
                    }
                    else
                    {
                        <span>
                            @question.CorrectOptionCode.
                            @question.CorrectOptionText
                        </span>
                    }
                </p>

                @if (!string.IsNullOrWhiteSpace(question.Explanation))
                {
                    <p class="mb-0">
                        <strong>Why:</strong> @question.Explanation
                    </p>
                }
            </article>
        }
    </section>

    <aside class="results-card">
        <h2>Assessment summary</h2>

        <dl class="results-summary">
            <div class="results-summary__row">
                <dt>Module</dt>
                <dd>Module @Model.ModuleId</dd>
            </div>
            <div class="results-summary__row">
                <dt>Questions answered</dt>
                <dd>@Model.Answered of @Model.TotalQuestions</dd>
            </div>
            <div class="results-summary__row">
                <dt>Score</dt>
                <dd>@Model.Score of @Model.TotalQuestions (@percentage%)</dd>
            </div>
        </dl>

        <a class="btn btn-primary w-100"
           asp-page="/Module"
           asp-route-id="@Model.ModuleId">
            Return to module
        </a>

        <p class="mt-3">
            <a asp-page="/Assessment"
               asp-route-moduleId="@Model.ModuleId">
                Start another assessment
            </a>
        </p>
    </aside>
</div>