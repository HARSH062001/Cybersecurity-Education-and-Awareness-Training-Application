@page
@model CybersecurityTrainingWeb.Pages.ResultsModel
@{
    ViewData["Title"] = "Assessment result";
    var percentage = Model.TotalQuestions > 0
        ? (int)Math.Round(100.0 * Model.Score / Model.TotalQuestions)
        : 0;
}

<section class="results-hero">
    <p class="eyebrow">Assessment result</p>
    <h1>@(Model.IsPassed ? "Assessment passed" : "Keep learning and try again")</h1>
    <p>Module @Model.ModuleId · @Model.ModuleTitle</p>
    <div class="results-hero__stat">
        <strong>@Model.Score / @Model.TotalQuestions</strong>
        <span>correct answers · @percentage%</span>
    </div>
    <p class="mt-3">
        Passing mark: @Model.PassingPercentage%. @(Model.IsPassed
            ? "You have passed this module and cannot retake its assessment."
            : "Review the module, then try another assessment attempt.")
    </p>
</section>

<div class="results-workspace">
    <section class="results-card">
        <p class="eyebrow">Question feedback</p>
        <h2>Learn from each answer</h2>
        <p>Your result and selected answers are saved to your account.</p>

        @foreach (var question in Model.Questions)
        {
            var status = question.IsCorrect
                ? "Correct"
                : question.SelectedOptionCode is null ? "Not answered" : "Review";
            <article class="question-card mb-3">
                <p class="eyebrow">Question @question.Number · @status</p>
                <h3 class="question-card__title">@question.QuestionText</h3>
                <p>
                    <strong>Your answer:</strong>
                    @if (question.SelectedOptionCode is null)
                    {
                        <span>No answer submitted.</span>
                    }
                    else
                    {
                        <span>@question.SelectedOptionCode. @question.SelectedOptionText</span>
                    }
                </p>
                @if (question.IsCorrect && !string.IsNullOrWhiteSpace(question.Explanation))
                {
                    <p class="mb-0"><strong>Why this is correct:</strong> @question.Explanation</p>
                }
                else if (!question.IsCorrect)
                {
                    <p class="mb-0">Review the related learning section and consider the safest action before your next attempt.</p>
                }
            </article>
        }
    </section>

    <aside class="results-card">
        <h2>Assessment summary</h2>
        <dl class="results-summary">
            <div class="results-summary__row">
                <dt>Module</dt>
                <dd>Module @Model.ModuleId</dd>
            </div>
            <div class="results-summary__row">
                <dt>Questions answered</dt>
                <dd>@Model.Answered of @Model.TotalQuestions</dd>
            </div>
            <div class="results-summary__row">
                <dt>Score</dt>
                <dd>@Model.Score of @Model.TotalQuestions (@percentage%)</dd>
            </div>
            <div class="results-summary__row">
                <dt>Result</dt>
                <dd>@(Model.IsPassed ? "Passed" : "Not passed")</dd>
            </div>
        </dl>
        <a class="btn btn-primary w-100" asp-page="/Module" asp-route-id="@Model.ModuleId">
            Return to module
        </a>
        @if (!Model.IsPassed)
        {
            <p class="mt-3">
                <a asp-page="/Assessment" asp-route-moduleId="@Model.ModuleId">Try another assessment</a>
            </p>
        }
    </aside>
</div>
