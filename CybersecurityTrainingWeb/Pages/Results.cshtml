@page
@model CybersecurityTrainingWeb.Pages.ResultsModel
@{
    ViewData["Title"] = "Practice attempt";
}

<section class="results-hero">
    <p class="eyebrow">Assessment attempt</p>
    <h1>Your assessment has been graded</h1>
    <p>Module @Model.ModuleId · @Model.ModuleTitle</p>

    <div class="results-hero__stat">
        <strong>@Model.Answered</strong>
        <span>of 10 questions answered</span>
    </div>
</section>

<div class="results-workspace">
    <section class="results-card">
    @if (Model.IsPassed)
    {
        
        <h2>Congratulations! You have passed this assessment.</h2>
        <p>
            Go back and revisit the module using the "Return to module" or you can go back to the Modules page to work on another module.
        </p>
    }
    else
    {
            <h2>Unfortunately, you have failed.</h2>
            <p>
                Go back and revisit the module using the "Return to module" button or you may try the assessment again.
            </p>   
    }
    <div class="assessment-questions">
            @for (var index = 0; index < Model.Questions.Count; index++)
            {
                var question = Model.Questions[index];

                <section class="question-card"
                         data-question-panel="@index">
                    <p class="eyebrow">Question @(index + 1)</p>
                    <h2 class="question-card__title">@question.Text</h2>

                    @if (question.Type == "multipleChoice")
                    {
                        <fieldset>
                            @foreach (var option in question.Options)
                            {
                                <label class="answer @(!option.DidUserAnswer ? "answer-option" : option.IsCorrectAnswer ? "answer-correct" : "answer-wrong")">
                                    <input type="radio"
                                           name="Answers[@question.DatabaseId]"
                                           value="@option.Code"
                                           data-answer-input="@question.Id"
                                           disabled
                                           checked="@option.DidUserAnswer"
                                            />
                                    <span class="answer-option__code">@option.Code</span>
                                    <span>@option.Text</span>
                                </label>
                            }
                        </fieldset>
                    }
                </section>
            }
            </div>
        </section>
    

    <aside class="results-card">
        <h2>Assessment summary</h2>

        <dl class="results-summary">
            <div class="results-summary__row">
                <dt>Module</dt>
                <dd>Module @Model.ModuleId</dd>
            </div>
            <div class="results-summary__row">
                <dt>Questions answered</dt>
                <dd>@Model.Answered of 10</dd>
            </div>
            <div class="results-summary__row">
                <dt>Score</dt>
                <dd>@Model.Score</dd>
            </div>
        </dl>

        <a class="btn btn-primary w-100"
           asp-page="/Module"
           asp-route-id="@Model.ModuleId">
            Return to module
        </a>
        @if (!@Model.IsPassed)
        {
            <p class="mt-3">
            <a asp-page="/Assessment" asp-route-moduleId="@Model.ModuleId">
                Try assessment again
            </a>
        </p>
        }
        
    </aside>
</div>