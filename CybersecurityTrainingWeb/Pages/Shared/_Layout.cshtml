<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cybersecurity Training</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CybersecurityTrainingWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="signal-header">
        <div class="signal-header__inner">
            <a class="signal-brand" asp-area="" asp-page="/Index">
                <span class="signal-brand__mark" aria-hidden="true">SD</span>
                <span>
                    <strong>Cybersecurity Training</strong>
                    <small>Workplace security learning</small>
                </span>
            </a>

            <nav class="signal-nav" aria-label="Main navigation">
                <a asp-area="" asp-page="/Dashboard">Dashboard</a>
                <a asp-area="" asp-page="/Modules">Learning route</a>
                <a asp-area="" asp-page="/Index">Home</a>
                <a class="signal-nav__action" asp-area="" asp-page="/Modules">View modules <span aria-hidden="true">↗</span></a>
            </nav>
        </div>
    </header>

    <div class="site-shell">
        <main role="main" class="site-main">
            @RenderBody()
        </main>
    </div>

    <footer class="signal-footer">
        <div class="site-shell signal-footer__inner">
            <span>Cybersecurity Training · Workplace security learning</span>
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>