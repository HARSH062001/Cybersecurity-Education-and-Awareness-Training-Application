@* Renders the shared navigation and page layout. *@
@using CybersecurityTrainingWeb.Data
@using Microsoft.AspNetCore.Antiforgery
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject IAntiforgery Antiforgery

@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var isAdmin = isSignedIn && User.IsInRole("Admin");
    var isModuleOwner = isSignedIn && User.IsInRole("ModuleOwner");
    var authState = isSignedIn ? "true" : "false";
    var badgeText = "CT";

    // Show the initials from the signed-in user's profile when available.
    if (isSignedIn)
    {
        var account = await UserManager.GetUserAsync(User);
        var fullName = account?.FullName?.Trim();

        if (!string.IsNullOrWhiteSpace(fullName))
        {
            var words = fullName.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);

            badgeText = words.Length == 1
                ? words[0][0].ToString().ToUpperInvariant()
                : $"{words[0][0]}{words[^1][0]}".ToUpperInvariant();
        }
    }

    // Create a request token for signed-in pages that submit data.
    var csrfToken = isSignedIn
        ? Antiforgery.GetAndStoreTokens(Context).RequestToken
        : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cybersecurity Training</title>

    @if (!string.IsNullOrEmpty(csrfToken))
    {
        <meta name="csrf-token" content="@csrfToken" />
    }

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CybersecurityTrainingWeb.styles.css" asp-append-version="true" />
</head>
<body data-authenticated="@authState">
    <a class="skip-link" href="#main-content">Skip to content</a>

    @* Shared site header and navigation. *@
    <header class="signal-header">
        <div class="signal-header__inner">
            <a class="signal-brand"
               asp-area=""
               asp-page="/Index"
               aria-label="Cybersecurity Training home">
                <span class="signal-brand__mark" aria-hidden="true">@badgeText</span>
                <span class="signal-brand__text">
                    <strong class="signal-brand__name">Cybersecurity Training</strong>
                    <small class="signal-brand__subtitle">Workplace cyber awareness</small>
                </span>
            </a>

            <nav class="signal-quick-nav" aria-label="Quick navigation">
                <a class="signal-quick-nav__dashboard" asp-area="" asp-page="/Dashboard" aria-label="Dashboard" title="Dashboard">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z" /></svg>
                    <span>Dashboard</span>
                </a>
                <a asp-area="" asp-page="/Modules" aria-label="Learning modules" title="Learning modules">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 4h7l2 2 2-2h7v16h-7l-2 2-2-2H3zM12 6v16" /></svg>
                    <span>Modules</span>
                </a>
                @if (isSignedIn)
                {
                    <a asp-area="" asp-page="/Notifications" aria-label="Notifications" title="Notifications">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /></svg>
                        <span>Notifications</span>
                    </a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" aria-label="Sign in" title="Sign in">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M14 3h7v18h-7M3 12h13M11 7l5 5-5 5" /></svg>
                        <span>Sign in</span>
                    </a>
                }
            </nav>

            <button class="signal-menu__toggle" type="button" aria-controls="main-navigation" aria-expanded="false" aria-label="Open navigation menu">
                <svg class="signal-menu__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
                <span>Menu</span>
            </button>

            <nav class="signal-nav" id="main-navigation" aria-label="Main navigation">
                <a class="signal-nav__small-screen" asp-area="" asp-page="/Dashboard">Dashboard</a>
                <a asp-area="" asp-page="/Modules">Learning route</a>
                <a asp-area="" asp-page="/Index">Home</a>

                @if (isSignedIn)
                {
                    @* Administrative navigation is limited to administrators. *@
                    @if (isAdmin)
                    {
                        <a asp-area="" asp-page="/AdminProgress">
                            Admin progress
                        </a>
                        <a asp-area="" asp-page="/AdminModuleOwners">
                            Module owners
                        </a>
                    }

                    @* Owners see their assigned-module reporting page. *@
                    @if (isModuleOwner)
                    {
                        <a asp-area="" asp-page="/OwnerDashboard">
                            Owner dashboard
                        </a>
                    }

                    @if (isAdmin || isModuleOwner) { <a asp-page="/TrainingManagement">Manage training</a> }
                    <a asp-area="" asp-page="/AssessmentHistory">
                        My assessments
                    </a>
                    <a asp-area="" asp-page="/Profile">My profile</a>

                    @* Link to Identity's authenticator and two-factor settings. *@
                    <a asp-area="Identity"
                       asp-page="/Account/Manage/TwoFactorAuthentication">
                        Account security
                    </a>

                    <form asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="/"
                          method="post"
                          class="m-0">
                        <button type="submit" class="btn btn-outline-light">
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register">
                        Register
                    </a>
                }
            </nav>
        </div>
    </header>

    <main id="main-content" class="site-shell site-main">
        @RenderBody()
    </main>

    @* Shared footer. *@
    <footer class="signal-footer">
        <div class="site-shell signal-footer__inner">
            <span>Cybersecurity Training · Eight-module learning pathway</span>
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Lets individual pages load their own scripts. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
