@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <div class="home-hero__copy">
        <p class="eyebrow">Employee security learning</p>
        <h1>Build safer habits,<br /><span>one decision at a time.</span></h1>
        <p class="lead">
            Practical cybersecurity learning for everyday work. Explore eight focused modules,
            confirm what you have learned and practise with the question banks for each topic.
        </p>

        <div class="home-hero__actions">
            <a class="btn btn-primary btn-lg" asp-page="/Modules">Explore learning modules</a>
            <a asp-page="/Dashboard">
                View my learning overview <span aria-hidden="true">→</span>
            </a>
        </div>

        <div class="home-trust">
            <span>8 learning modules</span>
            <span>24 question banks</span>
            <span>Section progress saved to your account when signed in</span>
        </div>
    </div>

    @* Loads the account-based progress summary used above. *@
    <aside class="home-panel" aria-label="Learning progress summary" data-overall-progress>
        <span class="home-panel__icon" aria-hidden="true">✓</span>
        <p class="eyebrow">Your learning path</p>
        <strong class="home-panel__number" data-overall-percent>0%</strong>
        <p data-overall-detail>0 of 8 modules completed</p>

        <div class="progress-track" role="progressbar"
             aria-label="Overall learning progress"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
            <div class="progress-track__fill" data-overall-bar style="width: 0%"></div>
        </div>

        <a asp-page="/Dashboard">Open learning overview →</a>
    </aside>
</section>

<section class="home-section">
    <div class="home-section__intro">
        <p class="eyebrow">How it works</p>
        <h2>A clear path from awareness to action</h2>
        <p class="lead">
            Learn practical security habits, confirm your progress and practise applying
            what you have learned.
        </p>
    </div>

    <div class="home-steps">
        <article class="step-card">
            <span class="step-card__number">01</span>
            <h3>Learn</h3>
            <p>Read focused guidance, examples and safe behaviours for each cybersecurity topic.</p>
        </article>

        <article class="step-card">
            <span class="step-card__number">02</span>
            <h3>Confirm progress</h3>
            <p>Mark each learning section complete when you have reviewed it at your own pace.</p>
        </article>

        <article class="step-card">
            <span class="step-card__number">03</span>
            <h3>Assess knowledge</h3>
            <p>Practise with the question banks provided for each module.</p>
        </article>
    </div>
</section>

<section class="home-ready-card">
    <div>
        <p class="eyebrow">Start with the basics</p>
        <h2>Cybersecurity Fundamentals</h2>
        <p>
            Understand common threats, secure accounts and devices, handle information safely
            and report concerns early.
        </p>
    </div>
    <a class="btn btn-light" asp-page="/Module" asp-route-id="1">Start Module 1</a>
</section>

@section Scripts {
    @* Loads the browser-side progress summary used above. *@
    <script src="~/js/module-progress.js" asp-append-version="true"></script>
}