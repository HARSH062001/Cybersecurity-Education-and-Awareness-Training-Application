@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
}

<section class="privacy-hero">
    <p class="eyebrow">Privacy information</p>
    <h1>How this learning prototype handles information</h1>
    <p class="lead">
        This page explains how the current application handles account details,
        learning progress and assessment responses.
    </p>
</section>

<div class="privacy-layout">
    <article class="privacy-content">
        <section>
            <h2>Learning progress</h2>
            <p>
                When you are signed in, confirmed module-section progress is saved
                to your account in the application database. Signed-out visitors
                cannot save section progress.
            </p>
        </section>

        <section>
            <h2>Assessment responses</h2>
            <p>
                While you work on an assessment, your answers are kept in this
                browser session. When you submit, your multiple-choice answers
                are sent to the application for marking. Your submitted answers,
                score and question feedback are saved with your account in the
                application database.
            </p>
        </section>

        <section>
            <h2>Account and learning records</h2>
            <p>
                The application stores your account details, confirmed
                learning-section progress and submitted assessment attempts.
                You must sign in to save progress or submit an assessment.
                You can reopen the result of a completed attempt using its
                Results page URL while signed in to the same account.
            </p>
        </section>

        @* This prototype notice is not a substitute for an approved production policy. *@
        <section>
            <h2>For this project</h2>
            <p>
                This page describes the current prototype. The team should
                confirm the final data-handling notice with the appropriate
                project or university contact before deployment.
            </p>
        </section>
    </article>

    <aside class="privacy-sidebar">
        <p class="eyebrow">Quick links</p>
        <h2>Continue learning</h2>
        <p>Return to the training pages when you are ready.</p>

        <p><a asp-page="/Modules">View learning modules →</a></p>
        <p><a asp-page="/Dashboard">Open your dashboard →</a></p>
        <p><a asp-page="/Index">Return home →</a></p>
    </aside>
</div>